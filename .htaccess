Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# Force https and drop www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://sostudy.lt%{REQUEST_URI} [L,R=301]

# Old site URLs
RewriteRule ^musu-kelione/?$ /apie-mus/#kelione [R=301,L,NE]
RewriteRule ^apie-mus$ /apie-mus/ [R=301,L]
RewriteRule ^reikia-pagalbos$ /reikia-pagalbos/ [R=301,L]
RewriteRule ^kontaktai$ /kontaktai/ [R=301,L]

# Keep the Apps Script sources private
RewriteRule ^apps-script/ - [F,L]

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
