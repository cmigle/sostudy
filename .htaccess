Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On
# Force https and drop www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://sostudy.lt%{REQUEST_URI} [L,R=301]

# Old site URLs
RewriteRule ^musu-kelione/?$ /apie-mus/#kelione [R=301,L,NE]
RewriteRule ^apie-mus$ /apie-mus/ [R=301,L]
RewriteRule ^reikia-pagalbos$ /reikia-pagalbos/ [R=301,L]
RewriteRule ^kontaktai$ /kontaktai/ [R=301,L]
RewriteRule ^privatumo-politika$ /privatumo-politika/ [R=301,L]
RewriteRule ^naudojimosi-taisykles$ /naudojimosi-taisykles/ [R=301,L]

# Keep repo-only files private if they are uploaded by mistake
RewriteRule ^apps-script/ - [F,L]
RewriteRule (^|/)\.(?!well-known/) - [F,L]
RewriteRule ^(README\.md|assets/js/config\.local\.example\.js)$ - [F,L]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

AddType font/woff2 .woff2

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  # CSS/JS links carry a ?v= hash, so they can be cached for a long time
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>
